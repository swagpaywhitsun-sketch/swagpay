# ─── WHITSUNPAY MoMo / Gateway Credentials ──────────────────────────────────
WHITSUNPAY_BASE_URL=https://developer.whitsun.dev
WHITSUNPAY_CLIENT_ID=your_client_id_here
WHITSUNPAY_API_KEY=your_api_key_here
WHITSUNPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── App Configuration ──────────────────────────────────────────────────────
PORT=8080
NEXT_PUBLIC_APP_NAME=SwagPay
NEXT_PUBLIC_MERCHANT_NAME=SwagPay Retail POS
NEXT_PUBLIC_DEFAULT_CURRENCY=GHS
# ─── Application Security (server refuses to start without these) ───────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# First-admin sign-in. Exists only as a deployment secret, never in the database.
ADMIN_BOOTSTRAP_EMAIL=you@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-secret
# Optional TTL overrides (defaults: 12h access token, 30d refresh token)
ACCESS_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_SECONDS=2592000

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
